# Copy to .env and fill in. Never commit .env.

# Development (default): Cursor subscription — no Anthropic API spend.
# Demo day: set LLM_PROVIDER=anthropic and configure Claude below.
LLM_PROVIDER=cursor_cli
CURSOR_API_KEY=
# Cursor CLI model (`agent --model`). auto = Cursor picks.
# Per-agent override: CURSOR_MODEL_ARCHITECT=claude-sonnet-5-thinking-high (agent key uppercased).
# Quota-friendly: *-medium / auto. When plan usage is low, prefer *-high on architect + QA to cut retries.
CURSOR_PROXY_MODEL=auto
# CURSOR_MODEL_ARCHITECT=claude-sonnet-5-thinking-high
# CURSOR_MODEL_BACKEND_DEVELOPER=gpt-5.3-codex
# CURSOR_MODEL_FRONTEND_DEVELOPER=gpt-5.3-codex
# CURSOR_MODEL_QA_ENGINEER=claude-sonnet-5-thinking-high
# CURSOR_MODEL_PROJECT_MANAGER=gemini-3.7-flash-medium
# CURSOR_MODEL_SMOKE_TESTER=gemini-3.7-flash-medium
# CURSOR_AGENT_TIMEOUT=600
# For LLM_PROVIDER=cursor_proxy also set:
# CURSOR_PROXY_BASE_URL=http://localhost:4646/v1

# How the agents call Claude when LLM_PROVIDER=anthropic:
#   true  -> through Claude Code on your Claude subscription. Needs CLAUDE_CODE_OAUTH_TOKEN
#            (create it with `claude setup-token`).
#   false -> the Claude API. Needs ANTHROPIC_API_KEY.
CLAUDE_CODE_ENABLE=false
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Optional: console (ask on the terminal) or auto (approve every gate without asking)
# SDLC_GATE_MODE=console

# Build sandbox: docker (recommended) or local (no Docker; needs node + flutter on PATH).
# SDLC_SANDBOX=local

# Console pipeline: pipeline.ui (fast M1 slice) or pipeline.client (M1+M2 client demo in one run).
# SDLC_PIPELINE=pipeline.client

# Release phase, local sandbox mode only: an EMPTY PostgreSQL database for staging.
# Migrations are applied to it. Example: postgresql://user:pass@localhost:5432/shopease_staging
# SDLC_STAGING_DATABASE_URL=
