// Simple Shop - catalogue data model (contract for the future backend; not deployed in M1).
// Prices: integer minor units + ISO 4217 code. Stock: per variant.
// Extra constraints added via raw SQL migration:
//   CHECK (price_minor >= 0), CHECK (stock_quantity >= 0), CHECK (currency ~ '^[A-Z]{3}$'),
//   CREATE UNIQUE INDEX product_variants_one_default ON product_variants(product_id) WHERE is_default;

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String           @id @default(uuid()) @db.Uuid
  slug         String           @unique @db.VarChar(200)
  name         String           @db.VarChar(200)
  description  String           @default("") @db.Text
  imageUrl     String?          @map("image_url") @db.VarChar(2048)
  thumbnailUrl String?          @map("thumbnail_url") @db.VarChar(2048)
  isActive     Boolean          @default(true) @map("is_active")
  sortOrder    Int              @default(0) @map("sort_order")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  variants     ProductVariant[]

  @@index([isActive, sortOrder, name])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  sku           String   @unique @db.VarChar(64)
  name          String   @default("Default") @db.VarChar(200)
  priceMinor    Int      @map("price_minor")
  currency      String   @default("GBP") @db.Char(3)
  stockQuantity Int      @default(0) @map("stock_quantity")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}
