<?xml version="1.0" encoding="utf-8"?>
<!-- Release/profile network policy: HTTPS only. No cleartext traffic.
     The debug source set overrides this file (android/app/src/debug/res/xml)
     to allow cleartext to the emulator host 10.0.2.2 only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
