<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow cleartext HTTP to local staging on the host
     machine as seen from the Android emulator (10.0.2.2). Everything else
     stays HTTPS-only. Release builds do not include this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
