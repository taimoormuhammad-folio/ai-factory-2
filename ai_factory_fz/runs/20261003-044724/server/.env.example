# Copy to .env for local development. Do not commit .env.
# Set DATABASE_URL to your local Postgres connection URL (credentials stay in .env only).
# Compose credentials from root .env.example: POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB.
DATABASE_URL=
JWT_SECRET=
PORT=3000
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12
