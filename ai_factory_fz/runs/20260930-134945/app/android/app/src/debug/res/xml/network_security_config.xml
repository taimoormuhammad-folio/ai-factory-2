<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow cleartext to the Android emulator host alias
     (local staging at http://10.0.2.2:<port>). Everything else stays https-only.
     Release builds do not include this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
