// Lumen Lighting Retail UK — PostgreSQL 16 (Prisma) — Release 2 / M3

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  pending_payment
  paid
  fulfilled
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  requires_payment_method
  requires_confirmation
  requires_action
  processing
  succeeded
  canceled
  failed
}

enum DeliveryOption {
  STANDARD
  EXPRESS
}

enum AddressLabel {
  home
  work
  other
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(CUSTOMER)
  displayName  String?   @map("display_name") @db.VarChar(100)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  addresses           Address[]
  cart                Cart?
  orders              Order[]
  wishlistItems       WishlistItem[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  label      AddressLabel @default(home)
  fullName   String       @map("full_name") @db.VarChar(100)
  line1      String       @db.VarChar(200)
  line2      String?      @db.VarChar(200)
  city       String       @db.VarChar(100)
  region     String?      @db.VarChar(100)
  postalCode String       @map("postal_code") @db.VarChar(16)
  country    String       @default("GB") @db.VarChar(2)
  isDefault  Boolean      @default(false) @map("is_default")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(80)
  slug      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  products Product[]

  @@map("brands")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  parent           Category?        @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[]       @relation("CategoryTree")
  products         Product[]
  couponCategories CouponCategory[]

  @@index([parentId])
  @@map("categories")
}

model HomeBanner {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(120)
  subtitle     String?  @db.VarChar(200)
  imageUrl     String   @map("image_url") @db.VarChar(500)
  ctaLabel     String   @map("cta_label") @db.VarChar(60)
  categorySlug String?  @map("category_slug") @db.VarChar(100)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("home_banners")
}

model Product {
  id               String   @id @default(uuid()) @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  brandId          String   @map("brand_id") @db.Uuid
  name             String   @db.VarChar(200)
  slug             String   @unique @db.VarChar(200)
  description      String   @db.Text
  primaryImageUrl  String   @map("primary_image_url") @db.VarChar(500)
  isActive         Boolean  @default(true) @map("is_active")
  isFeatured       Boolean  @default(false) @map("is_featured")
  popularityRank   Int?     @map("popularity_rank")
  unitsSold90Days  Int      @default(0) @map("units_sold_90_days")
  averageRating    Decimal  @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount      Int      @default(0) @map("review_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  category       Category         @relation(fields: [categoryId], references: [id])
  brand          Brand            @relation(fields: [brandId], references: [id])
  variants       ProductVariant[]
  images         ProductImage[]
  specs          LightingSpecification?
  reviews        Review[]
  views          ProductViewEvent[]
  wishlistItems  WishlistItem[]
  couponProducts CouponProduct[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, isFeatured])
  @@index([popularityRank])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar(500)
  altText   String?  @map("alt_text") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model LightingSpecification {
  productId         String   @id @map("product_id") @db.Uuid
  wattageW          Int?     @map("wattage_w")
  lumens            Int?
  colorTemperatureK Int?     @map("color_temperature_k")
  lightType         String?  @map("light_type") @db.VarChar(50)
  voltage           String?  @db.VarChar(30)
  dimmable          Boolean?
  material          String?  @db.VarChar(80)
  finish            String?  @db.VarChar(80)
  dimensionsMm      String?  @map("dimensions_mm") @db.VarChar(80)
  ipRating          String?  @map("ip_rating") @db.VarChar(10)
  bulbIncluded      Boolean? @map("bulb_included")
  installationType  String?  @map("installation_type") @db.VarChar(80)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("lighting_specifications")
}

model ProductVariant {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  sku               String   @unique @db.VarChar(64)
  label             String   @db.VarChar(120)
  priceCents        Int      @map("price_cents")
  compareAtCents    Int?     @map("compare_at_cents")
  currency          String   @default("GBP") @db.VarChar(3)
  stockQuantity     Int      @default(0) @map("stock_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  finish            String?  @db.VarChar(80)
  wattageW          Int?     @map("wattage_w")
  colorTemperatureK Int?     @map("color_temperature_k")
  imageUrl          String?  @map("image_url") @db.VarChar(500)
  isDefault         Boolean  @default(false) @map("is_default")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  guestCartItems GuestCartItem[]
  orderItems     OrderItem[]
  reservations   StockReservation[]

  @@index([productId])
  @@map("product_variants")
}

model Review {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  rating            Int
  title             String   @db.VarChar(120)
  body              String   @db.Text
  authorDisplayName String   @map("author_display_name") @db.VarChar(80)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("reviews")
}

model ProductViewEvent {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  sessionId String?  @map("session_id") @db.VarChar(64)
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("product_view_events")
}

model GuestCart {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  items GuestCartItem[]

  @@index([expiresAt])
  @@map("guest_carts")
}

model GuestCartItem {
  id             String   @id @default(uuid()) @db.Uuid
  guestCartId    String   @map("guest_cart_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  quantity       Int      @default(1)
  unitPriceCents Int      @map("unit_price_cents")
  currency       String   @default("GBP") @db.VarChar(3)
  productName    String   @map("product_name") @db.VarChar(200)
  variantLabel   String   @map("variant_label") @db.VarChar(120)
  sku            String   @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  guestCart GuestCart      @relation(fields: [guestCartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([guestCartId, variantId])
  @@index([guestCartId])
  @@map("guest_cart_items")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id             String   @id @default(uuid()) @db.Uuid
  cartId         String   @map("cart_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  quantity       Int      @default(1)
  unitPriceCents Int      @map("unit_price_cents")
  currency       String   @default("GBP") @db.VarChar(3)
  productName    String   @map("product_name") @db.VarChar(200)
  variantLabel   String   @map("variant_label") @db.VarChar(120)
  sku            String   @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model Coupon {
  id                String    @id @default(uuid()) @db.Uuid
  code              String    @unique @db.VarChar(32)
  description       String?   @db.VarChar(200)
  percentOff        Int?      @map("percent_off")
  amountOffCents    Int?      @map("amount_off_cents")
  currency          String    @default("GBP") @db.VarChar(3)
  minSubtotalCents  Int?      @map("min_subtotal_cents")
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz
  singleUsePerEmail Boolean   @default(false) @map("single_use_per_email")
  excludeSaleItems  Boolean   @default(true) @map("exclude_sale_items")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  redemptions CouponRedemption[]
  orders      Order[]
  categories  CouponCategory[]
  products    CouponProduct[]

  @@map("coupons")
}

model CouponCategory {
  couponId   String   @map("coupon_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@map("coupon_categories")
}

model CouponProduct {
  couponId  String   @map("coupon_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@map("coupon_products")
}

model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  orderId   String   @unique @map("order_id") @db.Uuid
  email     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, email])
  @@map("coupon_redemptions")
}

model CheckoutIdempotency {
  idempotencyKey String   @id @map("idempotency_key") @db.VarChar(64)
  orderId        String   @unique @map("order_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("checkout_idempotency")
}

model MockPaymentSession {
  id         String    @id @default(uuid()) @db.Uuid
  orderId    String    @unique @map("order_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("mock_payment_sessions")
}

model Order {
  id                      String         @id @default(uuid()) @db.Uuid
  orderNumber             String         @unique @map("order_number") @db.VarChar(20)
  userId                  String?        @map("user_id") @db.Uuid
  guestEmail              String?        @map("guest_email") @db.VarChar(255)
  status                  OrderStatus    @default(pending_payment)
  currency                String         @default("GBP") @db.VarChar(3)
  subtotalCents           Int            @map("subtotal_cents")
  discountCents           Int            @default(0) @map("discount_cents")
  shippingCents           Int            @default(0) @map("shipping_cents")
  vatCents                Int            @default(0) @map("vat_cents")
  totalCents              Int            @map("total_cents")
  deliveryOption          DeliveryOption @default(STANDARD) @map("delivery_option")
  couponId                String?        @map("coupon_id") @db.Uuid
  shippingAddressId       String?        @map("shipping_address_id") @db.Uuid
  shippingAddressSnapshot Json           @map("shipping_address_snapshot")
  idempotencyKey          String?        @unique @map("idempotency_key") @db.VarChar(64)
  stripePaymentIntentId   String?        @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  carrierName             String?        @map("carrier_name") @db.VarChar(80)
  trackingNumber          String?        @map("tracking_number") @db.VarChar(80)
  paidAt                  DateTime?      @map("paid_at") @db.Timestamptz
  fulfilledAt             DateTime?      @map("fulfilled_at") @db.Timestamptz
  deliveredAt             DateTime?      @map("delivered_at") @db.Timestamptz
  cancelledAt             DateTime?      @map("cancelled_at") @db.Timestamptz
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  user               User?               @relation(fields: [userId], references: [id])
  shippingAddress    Address?            @relation(fields: [shippingAddressId], references: [id])
  coupon             Coupon?             @relation(fields: [couponId], references: [id])
  items              OrderItem[]
  payment            Payment?
  reservations       StockReservation[]
  couponRedemption   CouponRedemption?
  mockPaymentSession MockPaymentSession?
  checkoutIdempotency CheckoutIdempotency?

  @@index([userId])
  @@index([guestEmail])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  productName    String   @map("product_name") @db.VarChar(200)
  variantLabel   String   @map("variant_label") @db.VarChar(120)
  sku            String   @db.VarChar(64)
  quantity       Int
  unitPriceCents Int      @map("unit_price_cents")
  currency       String   @default("GBP") @db.VarChar(3)
  lineTotalCents Int      @map("line_total_cents")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model StockReservation {
  id         String    @id @default(uuid()) @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  variantId  String    @map("variant_id") @db.Uuid
  quantity   Int
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  releasedAt DateTime? @map("released_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId, expiresAt])
  @@map("stock_reservations")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @unique @map("order_id") @db.Uuid
  provider              String        @default("mock") @db.VarChar(20)
  mockSessionId         String?       @unique @map("mock_session_id") @db.Uuid
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  status                PaymentStatus
  amountCents           Int           @map("amount_cents")
  currency              String        @default("GBP") @db.VarChar(3)
  stripeEventId         String?       @unique @map("stripe_event_id") @db.VarChar(255)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}
